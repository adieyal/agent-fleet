[importlinter]
root_packages =
    fleet
    fleet_cli
    fleet_web
include_external_packages = True

[importlinter:contract:layers]
name = Controller layers
type = layers
layers =
    fleet_cli | fleet_web
    fleet.container
    fleet.services : fleet.orchestration : fleet.triage : fleet.triage_scheduler : fleet.ingestion
    fleet.transport
    fleet.projections
    fleet.modules

[importlinter:contract:infrastructure]
name = Infrastructure construction
type = protected
protected_modules = fleet.infrastructure
allowed_importers = fleet.container

[importlinter:contract:module-independence]
name = Module independence
type = forbidden
source_modules = fleet.modules
forbidden_modules =
    fleet.infrastructure
    fleet_web
    fleet_cli
    fleet.container
    fleet.projections
    fleet.services
    fleet.ingestion
    fleet.orchestration
    fleet.triage
    fleet.triage_scheduler

# Each module's descendants are private, including its facade implementation.
# Add a public-surface contract whenever a new business module is introduced.
[importlinter:contract:authority-public]
name = Authority public surface
type = protected
protected_modules = fleet.modules.authority.*
allowed_importers = fleet.modules.authority

[importlinter:contract:attention-public]
name = Attention public surface
type = protected
protected_modules = fleet.modules.attention.*
allowed_importers = fleet.modules.attention

[importlinter:contract:decisions-public]
name = Decisions public surface
type = protected
protected_modules = fleet.modules.decisions.*
allowed_importers = fleet.modules.decisions

[importlinter:contract:execution-public]
name = Execution public surface
type = protected
protected_modules = fleet.modules.execution.*
allowed_importers = fleet.modules.execution

[importlinter:contract:library-public]
name = Library public surface
type = protected
protected_modules = fleet.modules.library.*
allowed_importers = fleet.modules.library

[importlinter:contract:records-public]
name = Records public surface
type = protected
protected_modules = fleet.modules.records.*
allowed_importers = fleet.modules.records

[importlinter:contract:work-public]
name = Work public surface
type = protected
protected_modules = fleet.modules.work.*
allowed_importers = fleet.modules.work

[importlinter:contract:workspace-public]
name = Workspace public surface
type = protected
protected_modules = fleet.modules.workspace.*
allowed_importers = fleet.modules.workspace

[importlinter:contract:module-domain]
name = Module domain layers
type = layers
containers = fleet.modules.*
layers =
    application
    domain

[importlinter:contract:worker]
name = Standalone worker
type = forbidden
source_modules = fleet.remote.fleetd
forbidden_modules =
    fleet
    fleet.**
    fleet_cli
    fleet_cli.**
    fleet_web
    fleet_web.**
as_packages = False

[importlinter:contract:document-library]
name = Document library independence
type = forbidden
source_modules =
    fleet.infrastructure.documents.job_store
    fleet.services
    fleet.orchestration
    fleet.triage
    fleet.triage_scheduler
    fleet.ingestion
forbidden_modules =
    fleet_cli
    fleet_web
    fleet.container

[importlinter:contract:service-infrastructure]
name = Service infrastructure separation
type = forbidden
source_modules =
    fleet.services
    fleet.orchestration
    fleet.triage
    fleet.triage_scheduler
forbidden_modules = fleet.infrastructure

[importlinter:contract:web-processes]
name = Web processes use transport
type = forbidden
source_modules = fleet_web
forbidden_modules = subprocess
allow_indirect_imports = True

[importlinter:contract:cli-processes]
name = CLI processes use transport
type = forbidden
source_modules = fleet_cli
forbidden_modules = subprocess
allow_indirect_imports = True

[importlinter:contract:service-presentation]
name = Services have no presentation dependencies
type = forbidden
source_modules =
    fleet.services
    fleet.orchestration
    fleet.triage
    fleet.triage_scheduler
forbidden_modules =
    argparse
    rich

[importlinter:contract:container-presentation]
name = Container has no presentation dependencies
type = forbidden
source_modules = fleet.container
forbidden_modules =
    fleet_cli
    fleet_web

[importlinter:contract:controller-internals]
name = Controllers use public providers and module surfaces
type = forbidden
source_modules =
    fleet_cli
    fleet_web
forbidden_modules =
    fleet.infrastructure
    fleet.services
    fleet.orchestration
    fleet.triage
    fleet.triage_scheduler
    fleet.ingestion
    fleet.transport
allow_indirect_imports = True

# Distribution boundaries apply to every module, including indirect imports.
[importlinter:contract:library-presentation]
name = Library has no presentation dependencies
type = forbidden
source_modules = fleet
forbidden_modules =
    fleet_cli
    fleet_web

[importlinter:contract:presentation-independence]
name = Presentation packages are independent
type = independence
modules =
    fleet_cli
    fleet_web
